# PromptCraft Environment Configuration Example
# Copy this file to .env and update with your settings

# Model Configuration
MODEL_PATH=Qwen3_4B_PromptCraft_GGUF_Q4_K_M.gguf
HF_REPO_ID=Sandeep4235/Qwen3-4B-PromptCraft-GGUF

# Inference Configuration
N_CTX=2048
N_THREADS=8
N_GPU_LAYERS=-1

# Generation Configuration
TEMPERATURE=0.3
TOP_P=0.9
MAX_TOKENS=2048

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/promptcraft.log

# Cache
CACHE_ENABLED=true
CACHE_PATH=.cache/promptcraft
CACHE_TTL_HOURS=24

# API Configuration (for future use)
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=false

# Hugging Face API Token (for model downloads)
HF_TOKEN=

# Development
DEBUG=false
